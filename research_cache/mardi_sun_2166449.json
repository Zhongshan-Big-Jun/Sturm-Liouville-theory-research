"mainsnak":{"snaktype":"value","property":"P28","hash":"c763b4bf6aa09d448ee2a1f4c2810cf527282214","datavalue":{"value":{"time":"+2022-08-24T00:00:00Z","timezone":0,"before":0,"after":0,"precision":11,"calendarmodel":"http://www.wikidata.org/entity/Q1985727"},"type":"time"},"datatype":"time"},"type":"statement","id":"Q2166449$E36610F4-EA81-40CB-9F05-71FE6776CBE3","rank":"normal"}],"P1448":[{"mainsnak":{"snaktype":"value","property":"P1448","hash":"ef75930916469192a6986ce04a1cfb83c055cb41","datavalue":{"value":"Consider a Sturm-Liouville problem with Dirichlet type boundary conditions (BCs). To speak more precise consider the differential equation \\[ y'' +\\lambda \\rho(x) y=0 \\] with BCs \\[ y(0)=y(1)=0. \\] As we know \\(\\rho(x)\\) is called the density function and describes the mass distribution of a string. There are mainly two important eigenvalue problems related with successive eigenvalues of this problem: Eigenvalue gap problem and eigenvalue ratio problem. In this paper, following [\\textit{J. Qi} et al., Qual. Theory Dyn. Syst. 19, No. 1, Paper No. 12, 15 p. (2020; Zbl 1456.34022)], the author deals with the minimum eigenvalue gap of the first two eigenvalues for \\(\\rho(x)\\), where \\(\\rho(x)\\) is piecewise continuous with a bounded of jumps. Contrary to previous works in the literature, in this paper, the author considers a more general case of this density function.","type":"string"},"datatype":"string"},"type":"statement","id":"Q2166449$C50A9582-6CAC-4214-8089-2A837B2911F8","rank":"normal"}],"P1447":[{"mainsnak":{"snaktype":"value","property":"P1447","hash":"65ca7024138a91f039a0522ba9abbde17b381981","datavalue":{"value":{"entity-type":"item","numeric-id":249902,"id":"Q249902"},"type":"wikibase-entityid"},"datatype":"wikibase-item"},"type":"statement","id":"Q2166449$A525DF9C-E4B8-4941-8825-52A1E138124F","rank":"normal"}],"P226":[{"mainsnak":{"snaktype":"value","property":"P226","hash":"75be5ce92fc5fc34a817435fa78115862dca90ff","datavalue":{"value"