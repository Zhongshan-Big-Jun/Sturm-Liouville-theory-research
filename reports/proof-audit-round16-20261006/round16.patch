+class BlockDirection:
+	"""A real piecewise-constant function, with its full breakpoint geometry.
+
+	Its immutable data, rather than samples at rounded global coordinates,
+	select the analytic pairing path. Endpoints have no effect on integrals.
+	"""
+	def __init__(self, Coeff, Edges):
+		self.coefficients = finite_vector(Coeff, 'block coefficients').copy()
+		self.edges = finite_vector(Edges, 'direction edges').copy()
+		if len(self.edges) != len(self.coefficients) + 1 or np.any(np.diff(self.edges) <= 0):
+			raise ValueError('direction edges must be strictly ordered and match coefficients')
+		self.coefficients.flags.writeable = False
+		self.edges.flags.writeable = False
+
+	def __call__(self, Points):
+		Points = finite_vector(Points, 'direction evaluation points')
+		if np.any(Points < self.edges[0]) or np.any(Points > self.edges[-1]):
+			raise ValueError('direction evaluation outside its domain')
+		Index = np.minimum(np.searchsorted(self.edges, Points, side='right') - 1, len(self.coefficients) - 1)
+		return self.coefficients[Index]
