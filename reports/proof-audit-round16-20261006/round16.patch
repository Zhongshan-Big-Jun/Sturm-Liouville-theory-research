+def _cos_sin_integrals(Waves, Length):
+	"""Integral cos_i*cos_j and (sin_i/w_i)*(sin_j/w_j) about a midpoint.
+
+	Use a bivariate Taylor series on a small-phase cell. Else use sinc, with
+	an mp fallback where subtraction cannot resolve the sine-product term.
+	The mp fallback is a numerical evaluation, not an interval certificate.
+	"""
+	Angles = Waves * Length / 2
+	if np.any(Angles <= 0) or not np.all(np.isfinite(Angles)):
+		raise ArithmeticError('local positive phases are not numerically resolvable')
+	Minus, Plus = Angles[:, None] - Angles[None, :], Angles[:, None] + Angles[None, :]
+	Sminus, Splus = np.sinc(Minus / np.pi), np.sinc(Plus / np.pi)
+	Cosine = Length * (Sminus + Splus) / 2
+	if np.max(np.abs(Angles)) < 0.05:
+		Sine = np.zeros_like(Cosine)
+		for p in range(6):
+			for q in range(6):
+				Sine += ((-1)**(p + q) * np.outer(Angles**(2*p), Angles**(2*q))
+					/ (math.factorial(2*p + 1) * math.factorial(2*q + 1) * (2*p + 2*q + 3)))
+		Sine *= Length**3 / 4
+	else:
+		Difference = Sminus - Splus
+		Sine = Length * Difference / (2 * np.outer(Waves, Waves))
+		Magnitude = np.abs(Sminus) + np.abs(Splus)
+		Unresolved = ((np.minimum(Angles[:, None], Angles[None, :]) < 0.05)
+			| (np.abs(Difference) <= 0.05 * Magnitude)
+			| (np.abs(Sminus+Splus) <= 0.05 * Magnitude))
+		# Resolve small sine-square differences to well beyond binary64 before
+		# conversion. A fixed precision is insufficient if one phase is tiny
+		# while another phase makes the global Taylor branch inapplicable.
+		Digits = max(60, 40+2*max(0, int(math.ceil(-math.log10(float(np.min(Angles)))))))
+		with mp.workdps(Digits):
+			for i, j in zip(*np.where(np.triu(Unresolved))):
+				Wi, Wj, L = mp.mpf(float(Waves[i])), mp.mpf(float(Waves[j])), mp.mpf(float(Length))
+				def Sinc(x):
+					return mp.sin(x)/x if x else mp.mpf(1)
+				Low, High = Sinc((Wi-Wj)*L/2), Sinc((Wi+Wj)*L/2)
+				Sine[i, j] = Sine[j, i] = float(L*(Low-High)/(2*Wi*Wj))
+				Cosine[i, j] = Cosine[j, i] = float(L*(Low+High)/2)
+	if not np.all(np.isfinite(Cosine)) or not np.all(np.isfinite(Sine)):
+		raise ArithmeticError('analytic local integrals exceed floating-point range')
+	if np.any(np.diag(Sine) <= 0):
+		raise ArithmeticError('positive local sine-square integral is below floating-point resolution')
+	return Cosine, Sine
