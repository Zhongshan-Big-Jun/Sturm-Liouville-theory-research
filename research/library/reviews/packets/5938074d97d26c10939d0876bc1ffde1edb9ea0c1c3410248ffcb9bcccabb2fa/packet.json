		},
		{
			"id": "R7-F02",
			"statement": "Verify complete uniform Volterra endpoint lemma for all measurable 1<=rho<=1+epsilon, including spectral squeeze, weighted normalization, slope separation, both endpoints, global C1 convergence, root isolation and the whole-block sign step in local U-uniqueness. Do not assume positive minimum first-block width or global C3 regularity.",
			"verification": "analytic"
		},
		{
			"id": "R7-F03",
			"statement": "Verify the general-n supremum limit (n+1)^2*pi^2 by the explicit thin-heavy-interval min-max construction with correct constants/widths and quantified function spaces. Separate global supremum from unproved all-R self-consistent branch asymptotics and n=1 historical numerical trends. Check conditional branch monotonicity scope.",
			"verification": "analytic"
		},
		{
			"id": "R7-F04-P01",
			"statement": "Verify single-interface versus symmetric-pair derivatives including shape-calculus sign/factor, generalized versus ordinary FH normalization and the constant-rho=2 counterexample. Check card scope and declared dependencies.",
			"verification": "analytic"
		},
		{
			"id": "R7-P02",
			"statement": "Check the explicitly revised adjacent tail statements: determinant sign versus inertia, the missing eigenvalue factor, contradictory historical determinant signs, the replacement of the invalid different-ODE Cauchy-uniqueness inference, and the distinction between a fixed-limit positive gap and an unproved quantitative box lower bound. Verify that no all-R G2 closure or untouched Hessian theory is certified by these local corrections.",
			"verification": "analytic"
		},
		{
			"id": "R7-card-propagation",
			"statement": "Check three directly affected tool cards: bare determinant G1 versus stronger definiteness, connected-path inertia premises, full versus mirror coordinates and half-gap Hessian, missing lambda factors, general-n Wronskian and supremum scope, and exact unchanged historical boundaries. Inspect edited sections against changed-lines evidence; retained Green and M3/KP derivations are explicitly not newly certified. Check that scoped release does not promote these untouched historical claims. Verify recon general-n correction.",
			"verification": "analytic"
		},
		{
			"id": "R7-summary-fidelity",
			"statement": "Check that every repaired card has an explicit current summary faithful to its repaired body and declared scope; the prior index inherited a demonstrably wrong fixed-L2/weighted-normalization summary. No stale assertion may survive merely in the retrieval preview. Check new FH dependency version bindings, without treating retrieval eligibility as full proof certification.",
			"verification": "analytic"
		},
		{
			"id": "R7-check-scope",
			"statement": "Inspect independent checker implementation, saved outputs and direct code propagation report. Require substantive nonstationary derivative evidence and honest finite numerical scope; the old factor must fail the stated test. No claim of running the missing external audit supplements or all historical programs.",
			"verification": "numerical"
		}
