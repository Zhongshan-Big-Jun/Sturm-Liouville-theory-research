	"claims": [
		{
			"id": "R11-formal-parity-fidelity",
			"statement": "Compare actual paired coordinates, sum/difference similarity, conditional reflection parity and zero/cross blocks, determinant sign and affine increment with every quantifier in the intended contract and blind readback. State the absent bridge to physically increasing indices, derivatives and concrete programs.",
			"verification": "formal"
		},
		{
			"id": "R11-formal-boundary-fidelity",
			"statement": "Compare explicit even/odd matrices, all-real determinant identities and positivity, and all-natural L>=4 unique real boundary correction with the contract and blind readback. The polynomial trace derivation, parity-basis row conversion, complex extension and approximation are outside this formal target.",
			"verification": "formal"
		},
		{
			"id": "R11-independent-formal-execution",
			"statement": "Personally execute the fresh compiler, original exact-root verifier, all declaration/definition/axiom comparisons and meaningful positive/negative controls in execution-scope.md. Verify the current source/environment and actual import resolution; preserve every actual failure and report evidence paths and limits.",
			"verification": "formal"
		}
	],
