+	U, V = Data['u_n'], Data['u_np1']
+	F = A * U**2 - B * V**2
+	M1 = (2*A*np.outer(U**2, U**2) - 2*B*np.outer(V**2, V**2) - np.outer(F, V**2)) * Jumps[None, :]
